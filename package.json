{
  "name": "arena-champions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "friend-server": "node scripts/friend-server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --isolate=false --maxWorkers=2",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:gimmicks": "node scripts/browser-gimmicks.mjs",
    "test:mega-reveal": "node scripts/browser-mega-reveal.mjs",
    "test:polish": "node scripts/browser-polish.mjs",
    "test:cinematic": "node scripts/browser-cinematic.mjs",
    "test:zygarde": "node scripts/browser-zygarde-mega.mjs",
    "test:correction": "node scripts/browser-correction.mjs",
    "test:server": "node --test scripts/friend-server.test.mjs",
    "test:dev": "node --test scripts/dev.test.mjs",
    "assets:metrics": "node scripts/generate-sprite-metrics.mjs",
    "data:gimmicks": "node scripts/generate-gimmicks.cjs",
    "test:choice": "node scripts/browser-choice.mjs",
    "test:conditions": "node scripts/browser-conditions.mjs",
    "assets:check": "node scripts/verify-sprites.mjs",
    "assets:forms": "node scripts/acquire-form-sprites.mjs",
    "assets:index": "node scripts/verify-sprites.mjs --write-manifest",
    "assets:acquire": "node scripts/acquire-sprites.mjs --all",
    "assets:supplement": "node scripts/supplement-sprites.mjs --all",
    "assets:supplement-pilot": "node scripts/supplement-sprites.mjs",
    "assets:audit": "node scripts/audit-sprites.mjs",
    "assets:pilot": "node scripts/audit-sprites.mjs --pilot",
    "test:sprite-errors": "node scripts/browser-sprite-errors.mjs",
    "test:sprite-scenes": "node scripts/browser-sprite-scenes.mjs",
    "data:refresh": "node scripts/generate-roster.cjs && node scripts/generate-legendary-roster.cjs && node scripts/generate-expansion-roster.cjs && node scripts/generate-champion-moves.cjs && node scripts/generate-mythical-roster.cjs && node scripts/generate-legacy-roster.cjs && node scripts/generate-gimmicks.cjs && node scripts/generate-sv-items.cjs",
    "assets:regmc": "node scripts/acquire-regmc-sprites.mjs",
    "assets:regmc:audit": "node scripts/audit-regmc-assets.mjs",
    "test:assets": "node scripts/browser-assets.mjs",
    "test:friend": "node scripts/browser-friend.mjs",
    "test:hit-effects": "node scripts/browser-hit-effects.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
