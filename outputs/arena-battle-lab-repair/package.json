{
  "name": "arena-champions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:choice": "node scripts/browser-choice.mjs",
    "test:conditions": "node scripts/browser-conditions.mjs",
    "assets:check": "node scripts/verify-sprites.mjs",
    "assets:index": "node scripts/verify-sprites.mjs --write-manifest",
    "data:refresh": "node scripts/download-data.cjs && node scripts/generate-roster.cjs",
    "test:assets": "node scripts/browser-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
